{
  "name": "@kickd0wn/react-dev-companion",
  "version": "0.2.1",
  "type": "module",
  "description": "A zero-dependency DevTools overlay for React and Next.js applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "playground": "npm --prefix playground run dev",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "nextjs",
    "devtools",
    "storage",
    "network-interceptor",
    "typescript"
  ],
  "author": "Kickz1nn <https://github.com/Kickz1nn>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kickz1nn/react-dev-companion.git"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}