{
  "name": "@kickd0wn/react-dev-companion",
  "version": "0.1.0",
  "type": "module",
  "description": "A zero-dependency DevTools overlay for React and Next.js applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "nextjs",
    "devtools",
    "storage",
    "network-interceptor",
    "typescript"
  ],
  "author": "Kickz1nn <https://github.com/Kickz1nn>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kickz1nn/react-dev-companion.git"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  }
}